{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "roxy.txt",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "color": {
      "keys": "cyan",
      "title": "bright_cyan"
    },
    "separator": " ✦ "
  },
  "modules": [
    {
      "type": "title",
      "format": "✧ {user-name} @ RoxyOS ✧"
    },
    "separator",
    {
      "type": "os",
      "format": "RoxyOS (Mushoku Tensei Edition)"
    },
    "host",
    {
      "type": "kernel",
      "format": "{sysname} {kernel-release}"
    },
    "uptime",
    "packages",
    "shell",
    "de",
    {
      "type": "wmtheme",
      "format": "roxy-shell"
    },
    "icons",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors"
  ]
}
