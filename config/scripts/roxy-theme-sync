#!/usr/bin/env python3
import subprocess
import sys

def apply_theme(scheme):
    scheme = scheme.strip().strip("\x27").strip("\"")
    if scheme == "prefer-dark":
        subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "roxy-shell"], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "adw-gtk3-dark"], check=False)
    else:
        subprocess.run(["gsettings", "set", "org.gnome.shell.extensions.user-theme", "name", "roxy-shell-light"], check=False)
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", "adw-gtk3"], check=False)

def main():
    res = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"], capture_output=True, text=True)
    apply_theme(res.stdout)

    proc = subprocess.Popen(["gsettings", "monitor", "org.gnome.desktop.interface", "color-scheme"], stdout=subprocess.PIPE, text=True)
    for line in proc.stdout:
        if ":" in line:
            line = line.split(":", 1)[1]
        apply_theme(line)

if __name__ == "__main__":
    main()
